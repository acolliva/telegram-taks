# Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Who can use the bot: Telegram user ids, comma separated.
# To find yours, write anything to the bot: if you're not allowed yet it replies with your id.
ALLOWED_USERS=

# Voice notes (Italian): off | local | openai
#   local  = faster-whisper on the Raspberry (pip install -r requirements-voice.txt)
#   openai = OpenAI transcription API (needs OPENAI_API_KEY; paid, a fraction of a cent per voice note)
TRANSCRIBER=off
# For local: tiny | base | small | medium. "small" is a good balance for Italian on a Pi 4/5;
# "base" is about 3x faster but makes more mistakes.
WHISPER_MODEL=small
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-transcribe

# "Done" view: default number of days shown
DONE_DAYS=7
TIMEZONE=Europe/Rome
DB_PATH=tasks.sqlite3
