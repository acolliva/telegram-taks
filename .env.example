# Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Who can use the bot: nothing to set here.
# The first person who writes to the bot becomes admin; anyone else who writes sends the
# admin a request with an "Abilita" button. You can also use: uv run taskbot users add ID
#
# Optional fixed lists (comma-separated Telegram ids), always allowed / always admin:
ADMIN_USERS=
ALLOWED_USERS=

# Voice notes (Italian): off | local | openai
#   local  = faster-whisper on the Raspberry (install with: uv sync --extra voice)
#   openai = OpenAI transcription API (needs OPENAI_API_KEY; paid, a fraction of a cent per voice note)
TRANSCRIBER=off
# For local: tiny | base | small | medium. "small" is a good balance for Italian on a Pi 4/5;
# "base" is about 3x faster but makes more mistakes.
WHISPER_MODEL=small
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini-transcribe

# "Done" view: default number of days shown
DONE_DAYS=7
TIMEZONE=Europe/Rome
DB_PATH=tasks.sqlite3
