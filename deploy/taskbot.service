# systemd unit for the Raspberry.
# Copy to /etc/systemd/system/taskbot.service, adjust User and the three paths
# (they must match the folder name exactly, capitals included), then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now taskbot
[Unit]
Description=Task bot - shared to-do list on Telegram
After=network-online.target
Wants=network-online.target

[Service]
User=nonno
WorkingDirectory=/home/nonno/task-reminder-telegram
EnvironmentFile=/home/nonno/task-reminder-telegram/.env
ExecStart=/home/nonno/task-reminder-telegram/.venv/bin/python -m taskbot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
